{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "EasyMigrate read-only access: one IAM role that only EasyMigrate (easymigrate.sudhan.tech) can use, and only with your session's external ID. It can read your infrastructure configuration and cannot change anything. Delete this stack to remove access.",
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "MinLength": 16,
      "Description": "Generated by EasyMigrate for your browser session. Keep it as filled in."
    },
    "RoleSuffix": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{8}$",
      "Description": "Generated by EasyMigrate. Keep it as filled in."
    }
  },
  "Resources": {
    "EasyMigrateReadOnlyRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "EasyMigrateReadOnly-${RoleSuffix}"
        },
        "Description": "Read-only access for EasyMigrate's scan. Delete the CloudFormation stack to remove it.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::538342414628:user/easymigrate-web"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "EasyMigrateScanReadOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "EasyMigrateScanReadOnly",
                  "Effect": "Allow",
                  "Action": [
                    "acm:DescribeCertificate",
                    "autoscaling:DescribeAutoScalingGroups",
                    "autoscaling:DescribeLifecycleHooks",
                    "autoscaling:DescribePolicies",
                    "ec2:DescribeAddresses",
                    "ec2:DescribeAvailabilityZones",
                    "ec2:DescribeCapacityReservations",
                    "ec2:DescribeFleets",
                    "ec2:DescribeHosts",
                    "ec2:DescribeImages",
                    "ec2:DescribeInstanceAttribute",
                    "ec2:DescribeInstanceTypes",
                    "ec2:DescribeInstances",
                    "ec2:DescribeInternetGateways",
                    "ec2:DescribeKeyPairs",
                    "ec2:DescribeLaunchTemplateVersions",
                    "ec2:DescribeLaunchTemplates",
                    "ec2:DescribeNatGateways",
                    "ec2:DescribeNetworkAcls",
                    "ec2:DescribeRouteTables",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeSpotFleetRequests",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeVolumes",
                    "ec2:DescribeVpcAttribute",
                    "ec2:DescribeVpcs",
                    "eks:DescribeAddon",
                    "eks:DescribeCluster",
                    "eks:DescribeFargateProfile",
                    "eks:DescribeNodegroup",
                    "eks:DescribePodIdentityAssociation",
                    "eks:ListAccessEntries",
                    "eks:ListAddons",
                    "eks:ListClusters",
                    "eks:ListFargateProfiles",
                    "eks:ListNodegroups",
                    "eks:ListPodIdentityAssociations",
                    "elasticloadbalancing:DescribeListenerCertificates",
                    "elasticloadbalancing:DescribeListeners",
                    "elasticloadbalancing:DescribeLoadBalancerAttributes",
                    "elasticloadbalancing:DescribeLoadBalancers",
                    "elasticloadbalancing:DescribeRules",
                    "elasticloadbalancing:DescribeTags",
                    "elasticloadbalancing:DescribeTargetGroupAttributes",
                    "elasticloadbalancing:DescribeTargetGroups",
                    "elasticloadbalancing:DescribeTargetHealth",
                    "iam:GetAccountAuthorizationDetails",
                    "iam:GetPolicyVersion",
                    "rds:DescribeDBClusters",
                    "rds:DescribeDBInstances",
                    "rds:DescribeDBParameterGroups",
                    "rds:DescribeDBParameters",
                    "rds:DescribeDBSubnetGroups",
                    "s3:GetAccelerateConfiguration",
                    "s3:GetAccountPublicAccessBlock",
                    "s3:GetBucketAcl",
                    "s3:GetBucketCORS",
                    "s3:GetBucketLocation",
                    "s3:GetBucketLogging",
                    "s3:GetBucketNotification",
                    "s3:GetBucketObjectLockConfiguration",
                    "s3:GetBucketOwnershipControls",
                    "s3:GetBucketPolicy",
                    "s3:GetBucketPolicyStatus",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:GetBucketRequestPayment",
                    "s3:GetBucketTagging",
                    "s3:GetBucketVersioning",
                    "s3:GetBucketWebsite",
                    "s3:GetEncryptionConfiguration",
                    "s3:GetIntelligentTieringConfiguration",
                    "s3:GetLifecycleConfiguration",
                    "s3:GetReplicationConfiguration",
                    "s3:ListAllMyBuckets",
                    "sts:GetCallerIdentity",
                    "tag:GetResources"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "Copy this value into EasyMigrate.",
      "Value": {
        "Fn::GetAtt": [
          "EasyMigrateReadOnlyRole",
          "Arn"
        ]
      }
    }
  }
}
