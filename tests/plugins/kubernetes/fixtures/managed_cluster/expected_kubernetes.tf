# decision K8S-NODE-SCALING@node_pool:workers → autoscale_totals (default)
resource "google_container_node_pool" "workers" {
  name               = "workers"
  cluster            = google_container_cluster.prod.id
  location           = var.region
  node_locations     = ["${var.region}-a", "${var.region}-b"]
  initial_node_count = 1

  autoscaling {
    total_min_node_count = 1
    total_max_node_count = 4
    location_policy      = "BALANCED"
  }
  management {
    auto_repair  = true
    auto_upgrade = true
  }
  upgrade_settings {
    max_surge       = 1
    max_unavailable = 1
  }
  node_config {
    machine_type = "n2-standard-2"
    image_type   = "COS_CONTAINERD"
    disk_size_gb = 50
    disk_type    = "pd-balanced"
    labels       = {
      role = "general"
    }
    tags         = ["fw-web-sg"]
    oauth_scopes = ["https://www.googleapis.com/auth/cloud-platform"]

    taint {
      key    = "dedicated"
      value  = "batch"
      effect = "NO_SCHEDULE"
    }
    workload_metadata_config {
      mode = "GKE_METADATA"
    }
  }
