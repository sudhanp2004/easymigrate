# Generated by EasyMigrate test. Do not edit by hand; re-run easymigrate plan.

# migrated instances behind load balancers, one group per zone (LB-BACKENDS)
resource "google_compute_instance_group" "lb_migration_test_vpc_a" {
  name      = "lb-migration-test-vpc-a"
  zone      = "${var.region}-a"
  network   = google_compute_network.migration_test_vpc.id
  instances = [google_compute_instance.web.self_link]

  named_port {
    name = "tg-app-tg"
    port = 80
  }
  named_port {
    name = "tg-ssh-tg"
    port = 22
  }
  named_port {
    name = "tg-tls-tg"
    port = 8443
  }
}

# proxy-only subnet for regional internal Application Load Balancers
resource "google_compute_subnetwork" "migration_test_vpc_proxy" {
  name          = "migration-test-vpc-proxy-only"
  ip_cidr_range = "100.126.0.0/23"
  region        = var.region
  network       = google_compute_network.migration_test_vpc.id
  purpose       = "REGIONAL_MANAGED_PROXY"
  role          = "ACTIVE"
}

resource "google_compute_region_health_check" "internal_app_app_tg" {
  name                = "internal-app-app-tg-hc"
  region              = var.region
  check_interval_sec  = 10
  timeout_sec         = 5
  healthy_threshold   = 3
  unhealthy_threshold = 2

  http_health_check {
    port         = 80
    request_path = "/health"
  }
}

# from AWS target-group app-tg
# decision LB-BACKENDS@target_group:app-tg → instance_groups (default)
# decision LB-HEALTH-CHECK@target_group:app-tg → map_health_check (default)
resource "google_compute_region_backend_service" "internal_app_app_tg" {
  name                            = "internal-app-app-tg"
  region                          = var.region
  load_balancing_scheme           = "INTERNAL_MANAGED"
  protocol                        = "HTTP"
  port_name                       = "tg-app-tg"
  health_checks                   = [google_compute_region_health_check.internal_app_app_tg.id]
  connection_draining_timeout_sec = 30

  backend {
    group           = google_compute_instance_group.lb_migration_test_vpc_a.id
    balancing_mode  = "UTILIZATION"
    capacity_scaler = 1.0
  }
}

resource "google_compute_region_url_map" "internal_app_80" {
  name            = "internal-app-80"
  region          = var.region
  default_service = google_compute_region_backend_service.internal_app_app_tg.id
}

resource "google_compute_region_target_http_proxy" "internal_app_80" {
  name    = "internal-app-80"
  region  = var.region
  url_map = google_compute_region_url_map.internal_app_80.id
}

resource "google_compute_forwarding_rule" "internal_app_80" {
  name                  = "internal-app-80"
  region                = var.region
  network               = google_compute_network.migration_test_vpc.id
  subnetwork            = google_compute_subnetwork.subnet_1.id
  load_balancing_scheme = "INTERNAL_MANAGED"
  ip_protocol           = "TCP"
  port_range            = "80"
  target                = google_compute_region_target_http_proxy.internal_app_80.id
  depends_on            = [google_compute_subnetwork.migration_test_vpc_proxy]
}

# lets the load balancer and its health checks reach the backends
resource "google_compute_firewall" "internal_app_backends" {
  name          = "internal-app-backends"
  network       = google_compute_network.migration_test_vpc.id
  direction     = "INGRESS"
  source_ranges = ["100.126.0.0/23", "130.211.0.0/22", "35.191.0.0/16"]
  target_tags   = ["fw-web-sg"]

  allow {
    protocol = "tcp"
    ports    = ["80"]
  }
}

# from AWS load-balancer ssh
# decision LB-SHAPE@load_balancer:ssh → map (default)
# decision LB-NEW-ADDRESS@load_balancer:ssh → reserve_ip (default)
resource "google_compute_address" "ssh" {
  name   = "ssh-ip"
  region = var.region
}

resource "google_compute_region_health_check" "ssh_ssh_tg" {
  name                = "ssh-ssh-tg-hc"
  region              = var.region
  check_interval_sec  = 10
  timeout_sec         = 5
  healthy_threshold   = 3
  unhealthy_threshold = 2

  tcp_health_check {
    port = 22
  }
}

# from AWS target-group ssh-tg
# decision LB-BACKENDS@target_group:ssh-tg → instance_groups (default)
# decision LB-HEALTH-CHECK@target_group:ssh-tg → map_health_check (default)
resource "google_compute_region_backend_service" "ssh_ssh_tg" {
  name                            = "ssh-ssh-tg"
  region                          = var.region
  load_balancing_scheme           = "EXTERNAL"
  protocol                        = "TCP"
  health_checks                   = [google_compute_region_health_check.ssh_ssh_tg.id]
  connection_draining_timeout_sec = 30

  backend {
    group          = google_compute_instance_group.lb_migration_test_vpc_a.id
    balancing_mode = "CONNECTION"
  }
}

resource "google_compute_forwarding_rule" "ssh_22" {
  name                  = "ssh-22-tcp"
  region                = var.region
  load_balancing_scheme = "EXTERNAL"
  ip_protocol           = "TCP"
  ports                 = ["22"]
  backend_service       = google_compute_region_backend_service.ssh_ssh_tg.id
  ip_address            = google_compute_address.ssh.address
}

# lets the load balancer and its health checks reach the backends
resource "google_compute_firewall" "ssh_health" {
  name          = "ssh-health"
  network       = google_compute_network.migration_test_vpc.id
  direction     = "INGRESS"
  source_ranges = ["209.85.152.0/22", "209.85.204.0/22", "35.191.0.0/16"]
  target_tags   = ["fw-web-sg"]

  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}
