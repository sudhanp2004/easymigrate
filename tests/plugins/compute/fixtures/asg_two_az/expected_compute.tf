# from AWS launch-template lt-web:1 (web-lt)
# decision VM-BOOT-IMAGE@instance_template:web-lt → stock_image (default)
# decision VM-BOOT-DISK-MINIMUM@instance_template:web-lt → grow_to_minimum (default)
# decision VM-MACHINE-TYPE@instance_template:web-lt → nearest_predefined (default)
# decision VM-SSH-KEYS@instance_template:web-lt → import_public_key (default)
# decision VM-USER-DATA@instance_template:web-lt → startup_script (default)
# decision VM-IMDS@instance_template:web-lt → note_only (default)
resource "google_compute_instance_template" "web_lt" {
  name_prefix  = "web-lt-"
  machine_type = "e2-small"

  disk {
    source_image = "rocky-linux-cloud/rocky-linux-9"
    boot         = true
    auto_delete  = true
    disk_size_gb = 20
    disk_type    = "pd-balanced"
  }
  disk {
    boot         = false
    auto_delete  = true
    disk_size_gb = 50
    disk_type    = "pd-balanced"
  }
  network_interface {
    subnetwork = google_compute_subnetwork.subnet_1.id
  }

  tags     = ["fw-web-sg"]
  metadata = {
    ssh-keys       = "ec2-user:ssh-rsa AAAAB3NzaC1 web-key"
    startup-script = "#!/bin/bash\necho asg\n"
  }

  lifecycle {
    create_before_destroy = true
  }
}

# autohealing for instance_group:web-asg (VM-ASG-HEALTHCHECK)
resource "google_compute_health_check" "web_asg" {
  name = "web-asg-hc"

  http_health_check {
    port         = 80
    request_path = "/"
  }
}

# lets Google's health-check probers reach instance_group:web-asg
resource "google_compute_firewall" "web_asg_hc" {
  name          = "web-asg-hc-allow"
  network       = google_compute_network.migration_test_vpc.id
  direction     = "INGRESS"
  source_ranges = ["130.211.0.0/22", "35.191.0.0/16"]
  target_tags   = ["fw-web-sg"]

  allow {
    protocol = "tcp"
    ports    = ["80"]
  }
}

# from AWS autoScalingGroup web-asg (web-asg)
# decision VM-ASG-SHAPE@instance_group:web-asg → regional_mig (default)
# decision VM-ASG-HEALTHCHECK@instance_group:web-asg → autohealing_http (default)
# decision VM-ASG-SCALING@instance_group:web-asg → cpu_target (default)
# decision VM-ASG-TARGET-GROUPS@instance_group:web-asg → drop_with_note (default)
# decision VM-ASG-LIFECYCLE@instance_group:web-asg → note_only (default)
resource "google_compute_region_instance_group_manager" "web_asg" {
  name                      = "web-asg"
  base_instance_name        = "web-asg"
  region                    = var.region
  distribution_policy_zones = ["${var.region}-a", "${var.region}-b"]

  version {
    instance_template = google_compute_instance_template.web_lt.id
  }
  auto_healing_policies {
    health_check      = google_compute_health_check.web_asg.id
    initial_delay_sec = 300
