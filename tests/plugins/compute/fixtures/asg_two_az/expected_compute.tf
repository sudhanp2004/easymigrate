}

# scaling for instance_group:web-asg (VM-ASG-SCALING)
resource "google_compute_region_autoscaler" "web_asg" {
  name   = "web-asg-as"
  region = var.region
  target = google_compute_region_instance_group_manager.web_asg.id

  autoscaling_policy {
    min_replicas    = 2
    max_replicas    = 6
    cooldown_period = 300

    cpu_utilization {
      target = 0.6
    }
  }
}
